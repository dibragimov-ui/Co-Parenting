# Postgres connection string (Neon or Supabase). Use the pooled URL on Vercel.
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# Auth.js. Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=

# Google OAuth client (Google Cloud console > APIs & Services > Credentials)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Public URL of the app, no trailing slash. On Vercel this can be left unset
# once the production domain exists (VERCEL_PROJECT_PRODUCTION_URL is used).
APP_URL=http://localhost:3000

# Encrypts the stored Google Calendar refresh token. 32 random bytes, base64:
#   openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Protects the nightly sync endpoint. Vercel Cron sends it automatically.
CRON_SECRET=
